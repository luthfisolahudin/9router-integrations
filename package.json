{
  "name": "@luthfisolahudin/9router-integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical 9Router model-catalog integration shared by OpenCode, standalone Pi, and tt Pi.",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
